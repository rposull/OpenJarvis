# Copy to .env in this directory (or ~/.openjarvis/.env) for phone/email alerts.
# Existing shell env vars always win — nothing here overwrites deployment secrets.

# --- Push (easiest — free ntfy app on your phone) ---
# 1. Install ntfy app, subscribe to a private topic name
# 2. Set NTFY_TOPIC below
NTFY_TOPIC=your-private-topic-name
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# --- SMS (Twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# MY_PHONE_NUMBER=+1...

# --- Email (SMTP) ---
# EMAIL_FROM=you@yourbusiness.com
# EMAIL_TO=you@yourbusiness.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@yourbusiness.com
# SMTP_PASSWORD=app-password-here
