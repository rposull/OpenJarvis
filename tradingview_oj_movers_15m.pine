//@version=6
indicator('OJ 0DTE 15m', overlay=true, max_labels_count=500, max_lines_count=50)

// 0DTE: ORB morning · EMA wait later · scale TP1/2/3 · flat 15:45 NY
emaFastLen = input.int(5, 'Fast EMA')
emaSlowLen = input.int(21, 'Slow EMA')
atrLen     = input.int(14, 'ATR')
atrMultSL  = input.float(0.85, 'SL ATR mult', minval=0.1, step=0.05, tooltip='Higher = more room under/over the entry candle so wicks do not stop you out.')
tp1R       = input.float(0.5, 'TP1 R', minval=0.1, step=0.1)
tp2R       = input.float(1.0, 'TP2 R', minval=0.2, step=0.1)
tp3R       = input.float(1.5, 'TP3 R', minval=0.3, step=0.1)
waitBars   = input.int(3, 'EMA wait bars', minval=0, maxval=8)
orbMins    = input.int(15, 'ORB minutes', options=[15, 30])
flatHH     = input.int(15, 'Flat hour NY')
flatMM     = input.int(45, 'Flat minute NY')

ny = 'America/New_York'
newDay = timeframe.change('D')
nyH = hour(time, ny)
nyM = minute(time, ny)
pastFlat = nyH > flatHH or (nyH == flatHH and nyM >= flatMM)
canEnter = not na(time(timeframe.period, '0930-1545', ny)) and not pastFlat
inOrbBuild = not na(time(timeframe.period, orbMins == 15 ? '0930-0945' : '0930-1000', ny))

emaF = ta.ema(close, emaFastLen)
emaS = ta.ema(close, emaSlowLen)
atr  = ta.atr(atrLen)
bull = emaF > emaS
bear = emaF < emaS
crossUp = bull and bull != bull[1] and close > open
crossDn = bear and bear != bear[1] and close < open

// --- ORB ---
var float orbHi = na
var float orbLo = na
var bool orbReady = false
var bool orbUsed = false

if newDay
    orbHi := na
    orbLo := na
    orbReady := false
    orbUsed := false

if inOrbBuild
    orbHi := na(orbHi) ? high : math.max(orbHi, high)
    orbLo := na(orbLo) ? low : math.min(orbLo, low)
else if not na(orbHi) and not na(orbLo)
    orbReady := true

orbOk = atr > 0 and not na(orbHi) and (orbHi - orbLo) > atr * 0.2 and (orbHi - orbLo) < atr * 2.5
orbCall = canEnter and orbReady and not orbUsed and nyH < 11 and orbOk and close > orbHi and close > open
orbPut  = canEnter and orbReady and not orbUsed and nyH < 11 and orbOk and close < orbLo and close < open

// --- EMA wait ---
var int pend = 0
var int pendBar = na

if newDay or not canEnter
    pend := 0
    pendBar := na
if canEnter and crossUp
    pend := 1
    pendBar := bar_index
if canEnter and crossDn
    pend := -1
    pendBar := bar_index
if pend == 1 and bear
    pend := 0
if pend == -1 and bull
    pend := 0

waited = pend != 0 and not na(pendBar) ? bar_index - pendBar : 0
if pend != 0 and waited > waitBars + 5
    pend := 0

nearSlow = atr > 0 and math.abs(close - emaS) / atr <= 1.5
emaCall = canEnter and pend == 1 and waited >= waitBars and bull and close > open and close >= emaS and nearSlow and low <= math.max(emaF, emaS) + atr * 0.25
emaPut  = canEnter and pend == -1 and waited >= waitBars and bear and close < open and close <= emaS and nearSlow and high >= math.min(emaF, emaS) - atr * 0.25

// --- Position ---
var float entry = na
var float sl = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var bool inPos = false
var string side = ''
var string markSide = ''
var string entryKind = ''
var bool tp1Done = false
var bool tp2Done = false
var bool tp3Done = false

callHit = false
putHit = false
tp1Hit = false
tp2Hit = false
tp3Hit = false
slHit = false
eodHit = false
flipHit = false

if inPos and (newDay or pastFlat)
    eodHit := true
    inPos := false
    side := ''
    pend := 0

if inPos and side == 'CALL'
    if not tp1Done and high >= tp1
        tp1Hit := true
        tp1Done := true
    if not tp2Done and high >= tp2
        tp2Hit := true
        tp2Done := true
    if not tp3Done and high >= tp3
        tp3Hit := true
        tp3Done := true
        inPos := false
        side := ''
    if inPos and low <= sl
        slHit := true
        inPos := false
        side := ''

if inPos and side == 'PUT'
    if not tp1Done and low <= tp1
        tp1Hit := true
        tp1Done := true
    if not tp2Done and low <= tp2
        tp2Hit := true
        tp2Done := true
    if not tp3Done and low <= tp3
        tp3Hit := true
        tp3Done := true
        inPos := false
        side := ''
    if inPos and high >= sl
        slHit := true
        inPos := false
        side := ''

goCall = (orbCall or emaCall) and (not inPos or side == 'PUT')
goPut  = (orbPut or emaPut) and (not inPos or side == 'CALL')
fromOrbCall = orbCall
fromOrbPut  = orbPut

if goCall
    if inPos and side == 'PUT'
        flipHit := true
        inPos := false
    entry := close
    // ATR stop with buffer past the entry candle extreme (avoids wick stops)
    sl := low - atr * atrMultSL
    risk = entry - sl
    if risk > 0
        tp1 := entry + risk * tp1R
        tp2 := entry + risk * tp2R
        tp3 := entry + risk * tp3R
        inPos := true
        side := 'CALL'
        markSide := 'CALL'
        entryKind := fromOrbCall ? 'ORB' : 'EMA'
        callHit := true
        tp1Done := false
        tp2Done := false
        tp3Done := false
        pend := 0
        if orbCall
            orbUsed := true
        label.new(bar_index, tp1, 'TP1', style=label.style_label_left, color=color.new(#69f0ae, 0), textcolor=color.black, size=size.tiny)
        label.new(bar_index, tp2, 'TP2', style=label.style_label_left, color=color.new(#00e676, 0), textcolor=color.black, size=size.tiny)
        label.new(bar_index, tp3, 'TP3', style=label.style_label_left, color=color.new(#00c853, 0), textcolor=color.white, size=size.tiny)

if goPut
    if inPos and side == 'CALL'
        flipHit := true
        inPos := false
    entry := close
    sl := high + atr * atrMultSL
    risk = sl - entry
    if risk > 0
        tp1 := entry - risk * tp1R
        tp2 := entry - risk * tp2R
        tp3 := entry - risk * tp3R
        inPos := true
        side := 'PUT'
        markSide := 'PUT'
        entryKind := fromOrbPut ? 'ORB' : 'EMA'
        putHit := true
        tp1Done := false
        tp2Done := false
        tp3Done := false
        pend := 0
        if orbPut
            orbUsed := true
        label.new(bar_index, tp1, 'TP1', style=label.style_label_left, color=color.new(#69f0ae, 0), textcolor=color.black, size=size.tiny)
        label.new(bar_index, tp2, 'TP2', style=label.style_label_left, color=color.new(#00e676, 0), textcolor=color.black, size=size.tiny)
        label.new(bar_index, tp3, 'TP3', style=label.style_label_left, color=color.new(#00c853, 0), textcolor=color.white, size=size.tiny)

// --- Visuals ---
bgcolor(not canEnter ? color.new(color.gray, 93) : na)
plot(emaF, 'EMA 5', color=color.new(color.teal, 0), linewidth=2)
plot(emaS, 'EMA 21', color=color.new(color.orange, 0), linewidth=2)
plot(orbReady and canEnter ? orbHi : na, 'ORB Hi', color=color.new(#00bcd4, 30), style=plot.style_linebr)
plot(orbReady and canEnter ? orbLo : na, 'ORB Lo', color=color.new(#ff7043, 30), style=plot.style_linebr)
plot(inPos ? entry : na, 'Entry', color=color.new(color.white, 30), style=plot.style_linebr)
plot(inPos ? sl : na, 'SL', color=color.red, style=plot.style_linebr, linewidth=2)
plot(inPos ? tp1 : na, 'TP1', color=color.new(#69f0ae, 0), style=plot.style_linebr)
plot(inPos ? tp2 : na, 'TP2', color=color.new(#00e676, 0), style=plot.style_linebr)
plot(inPos ? tp3 : na, 'TP3', color=color.new(#00c853, 0), style=plot.style_linebr, linewidth=2)

plotshape(callHit, title='CALL', style=shape.labelup, location=location.belowbar, color=color.lime, text='CALL', textcolor=color.white, size=size.small)
plotshape(putHit, title='PUT', style=shape.labeldown, location=location.abovebar, color=color.red, text='PUT', textcolor=color.white, size=size.small)
plotshape(slHit, title='SL', style=shape.xcross, location=location.belowbar, color=color.red, text='SL', textcolor=color.white, size=size.tiny)
plotshape(eodHit, title='EOD', style=shape.xcross, location=location.abovebar, color=color.gray, text='EOD', textcolor=color.white, size=size.tiny)

// Mark TP hits on the chart at the TP price
if tp1Hit and not na(tp1)
    label.new(bar_index, tp1, 'TP1 ✓', style=markSide == 'PUT' ? label.style_label_up : label.style_label_down, color=color.new(#69f0ae, 0), textcolor=color.black, size=size.small)
if tp2Hit and not na(tp2)
    label.new(bar_index, tp2, 'TP2 ✓', style=markSide == 'PUT' ? label.style_label_up : label.style_label_down, color=color.new(#00e676, 0), textcolor=color.black, size=size.small)
if tp3Hit and not na(tp3)
    label.new(bar_index, tp3, 'TP3 ✓', style=markSide == 'PUT' ? label.style_label_up : label.style_label_down, color=color.new(#00c853, 0), textcolor=color.white, size=size.normal)

// Fixed info box — bottom left (not on candles)
px(float v) =>
    na(v) ? '—' : str.tostring(v, format.mintick)

var table box = table.new(position.bottom_left, 2, 8, bgcolor=color.new(#111111, 15), border_width=1, border_color=color.new(color.gray, 40))
if barstate.islast
    sideTxt = markSide == 'CALL' ? 'BULL CALL' : markSide == 'PUT' ? 'BEAR PUT' : '—'
    sideCol = markSide == 'CALL' ? color.lime : markSide == 'PUT' ? color.red : color.gray
    statTxt = inPos ? 'OPEN' : not na(entry) ? 'CLOSED' : 'FLAT'
    statCol = inPos ? color.yellow : color.gray

    table.cell(box, 0, 0, 'Side', text_color=color.gray, text_size=size.small)
    table.cell(box, 1, 0, sideTxt + (entryKind != '' ? ' · ' + entryKind : ''), text_color=sideCol, text_size=size.normal)
    table.cell(box, 0, 1, 'Status', text_color=color.gray, text_size=size.small)
    table.cell(box, 1, 1, statTxt, text_color=statCol, text_size=size.small)
    table.cell(box, 0, 2, 'Entry', text_color=color.gray, text_size=size.small)
    table.cell(box, 1, 2, px(entry), text_color=color.white, text_size=size.small)
    table.cell(box, 0, 3, 'SL', text_color=color.gray, text_size=size.small)
    table.cell(box, 1, 3, px(sl), text_color=color.red, text_size=size.small)
    table.cell(box, 0, 4, 'TP1', text_color=color.gray, text_size=size.small)
    table.cell(box, 1, 4, px(tp1), text_color=#69f0ae, text_size=size.small)
    table.cell(box, 0, 5, 'TP2', text_color=color.gray, text_size=size.small)
    table.cell(box, 1, 5, px(tp2), text_color=#00e676, text_size=size.small)
    table.cell(box, 0, 6, 'TP3', text_color=color.gray, text_size=size.small)
    table.cell(box, 1, 6, px(tp3), text_color=#00c853, text_size=size.small)
    table.cell(box, 0, 7, 'Hits', text_color=color.gray, text_size=size.small)
    table.cell(box, 1, 7, (tp1Done ? 'TP1 ' : '') + (tp2Done ? 'TP2 ' : '') + (tp3Done ? 'TP3' : (inPos ? '—' : '')), text_color=color.aqua, text_size=size.small)

// --- Alerts ---
alertcondition(callHit, 'ENTRY CALL', 'ENTRY CALL {{ticker}}')
alertcondition(putHit, 'ENTRY PUT', 'ENTRY PUT {{ticker}}')
alertcondition(tp1Hit, 'TP1', 'TP1 {{ticker}}')
alertcondition(tp2Hit, 'TP2', 'TP2 {{ticker}}')
alertcondition(tp3Hit, 'TP3', 'TP3 {{ticker}}')
alertcondition(slHit, 'SL', 'SL {{ticker}}')
alertcondition(eodHit, 'EOD', 'EOD FLAT {{ticker}}')
alertcondition(flipHit, 'FLIP', 'FLIP {{ticker}}')

if callHit
    alert('ENTRY CALL ' + entryKind + ' ' + syminfo.ticker + ' ' + str.tostring(close) + ' sl=' + str.tostring(sl) + ' tp1=' + str.tostring(tp1) + ' tp2=' + str.tostring(tp2) + ' tp3=' + str.tostring(tp3), alert.freq_once_per_bar_close)
if putHit
    alert('ENTRY PUT ' + entryKind + ' ' + syminfo.ticker + ' ' + str.tostring(close) + ' sl=' + str.tostring(sl) + ' tp1=' + str.tostring(tp1) + ' tp2=' + str.tostring(tp2) + ' tp3=' + str.tostring(tp3), alert.freq_once_per_bar_close)
if tp1Hit
    alert('TP1 ' + syminfo.ticker, alert.freq_once_per_bar_close)
if tp2Hit
    alert('TP2 ' + syminfo.ticker, alert.freq_once_per_bar_close)
if tp3Hit
    alert('TP3 ' + syminfo.ticker, alert.freq_once_per_bar_close)
if slHit
    alert('SL ' + syminfo.ticker, alert.freq_once_per_bar_close)
if eodHit
    alert('EOD FLAT ' + syminfo.ticker, alert.freq_once_per_bar_close)
