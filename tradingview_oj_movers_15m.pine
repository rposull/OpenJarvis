//@version=6
indicator('OJ 0DTE 15m', overlay=true, max_labels_count=500, max_lines_count=500)

// 0DTE: ORB morning · EMA wait later · scale TP1/2/3 · flat 15:45 NY
emaFastLen = input.int(5, 'Fast EMA')
emaSlowLen = input.int(21, 'Slow EMA')
atrLen     = input.int(14, 'ATR')
atrMultSL  = input.float(0.5, 'SL ATR mult', step=0.1)
rr         = input.float(3.0, 'TP3 R:R', step=0.5)
waitBars   = input.int(3, 'EMA wait bars', minval=0, maxval=8)
orbMins    = input.int(15, 'ORB minutes', options=[15, 30])
flatHH     = input.int(15, 'Flat hour NY')
flatMM     = input.int(45, 'Flat minute NY')

ny = 'America/New_York'
newDay = timeframe.change('D')
nyH = hour(time, ny)
nyM = minute(time, ny)
pastFlat = nyH > flatHH or (nyH == flatHH and nyM >= flatMM)
canEnter = not na(time(timeframe.period, '0930-1545', ny)) and not pastFlat
inOrbBuild = not na(time(timeframe.period, orbMins == 15 ? '0930-0945' : '0930-1000', ny))

emaF = ta.ema(close, emaFastLen)
emaS = ta.ema(close, emaSlowLen)
atr  = ta.atr(atrLen)
bull = emaF > emaS
bear = emaF < emaS
crossUp = bull and bull != bull[1] and close > open
crossDn = bear and bear != bear[1] and close < open

// --- ORB ---
var float orbHi = na
var float orbLo = na
var bool orbReady = false
var bool orbUsed = false

if newDay
    orbHi := na
    orbLo := na
    orbReady := false
    orbUsed := false

if inOrbBuild
    orbHi := na(orbHi) ? high : math.max(orbHi, high)
    orbLo := na(orbLo) ? low : math.min(orbLo, low)
else if not na(orbHi) and not na(orbLo)
    orbReady := true

orbOk = atr > 0 and not na(orbHi) and (orbHi - orbLo) > atr * 0.2 and (orbHi - orbLo) < atr * 2.5
orbCall = canEnter and orbReady and not orbUsed and nyH < 11 and orbOk and close > orbHi and close > open
orbPut  = canEnter and orbReady and not orbUsed and nyH < 11 and orbOk and close < orbLo and close < open

// --- EMA wait ---
var int pend = 0
var int pendBar = na

if newDay or not canEnter
    pend := 0
    pendBar := na
if canEnter and crossUp
    pend := 1
    pendBar := bar_index
if canEnter and crossDn
    pend := -1
    pendBar := bar_index
if pend == 1 and bear
    pend := 0
if pend == -1 and bull
    pend := 0

waited = pend != 0 and not na(pendBar) ? bar_index - pendBar : 0
if pend != 0 and waited > waitBars + 5
    pend := 0

nearSlow = atr > 0 and math.abs(close - emaS) / atr <= 1.5
emaCall = canEnter and pend == 1 and waited >= waitBars and bull and close > open and close >= emaS and nearSlow and low <= math.max(emaF, emaS) + atr * 0.25
emaPut  = canEnter and pend == -1 and waited >= waitBars and bear and close < open and close <= emaS and nearSlow and high >= math.min(emaF, emaS) - atr * 0.25

// --- Position ---
var float entry = na
var float sl = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var bool inPos = false
var string side = ''
var string markSide = ''
var string entryKind = ''
var int entryBar = na
var bool tp1Done = false
var bool tp2Done = false
var bool tp3Done = false

// Active trade rays (extend while open; prior trades stay on chart)
var line lnEntry = na
var line lnSl = na
var line lnTp1 = na
var line lnTp2 = na
var line lnTp3 = na

callHit = false
putHit = false
tp1Hit = false
tp2Hit = false
tp3Hit = false
slHit = false
eodHit = false
flipHit = false

f_tag(string s, string kind) =>
    (s == 'CALL' ? 'BULL CALL' : 'BEAR PUT') + (kind != '' ? ' · ' + kind : '')

f_card(string s, string kind, float e, float sL, float t1, float t2, float t3) =>
    f_tag(s, kind) + '\nEntry ' + str.tostring(e, format.mintick) + '\nTP1 ' + str.tostring(t1, format.mintick) + '  TP2 ' + str.tostring(t2, format.mintick) + '  TP3 ' + str.tostring(t3, format.mintick) + '\nSL ' + str.tostring(sL, format.mintick)

if inPos and (newDay or pastFlat)
    eodHit := true
    inPos := false
    side := ''
    pend := 0

if inPos and side == 'CALL'
    if not tp1Done and high >= tp1
        tp1Hit := true
        tp1Done := true
    if not tp2Done and high >= tp2
        tp2Hit := true
        tp2Done := true
    if not tp3Done and high >= tp3
        tp3Hit := true
        tp3Done := true
        inPos := false
        side := ''
    if inPos and low <= sl
        slHit := true
        inPos := false
        side := ''

if inPos and side == 'PUT'
    if not tp1Done and low <= tp1
        tp1Hit := true
        tp1Done := true
    if not tp2Done and low <= tp2
        tp2Hit := true
        tp2Done := true
    if not tp3Done and low <= tp3
        tp3Hit := true
        tp3Done := true
        inPos := false
        side := ''
    if inPos and high >= sl
        slHit := true
        inPos := false
        side := ''

goCall = (orbCall or emaCall) and (not inPos or side == 'PUT')
goPut  = (orbPut or emaPut) and (not inPos or side == 'CALL')
fromOrbCall = orbCall
fromOrbPut  = orbPut

if goCall
    if inPos and side == 'PUT'
        flipHit := true
        inPos := false
    entry := close
    sl := fromOrbCall and not na(orbLo) ? orbLo - atr * atrMultSL * 0.25 : low - atr * atrMultSL
    risk = entry - sl
    if risk > 0
        tp1 := entry + risk
        tp2 := entry + risk * 2
        tp3 := entry + risk * rr
        inPos := true
        side := 'CALL'
        markSide := 'CALL'
        entryKind := fromOrbCall ? 'ORB' : 'EMA'
        entryBar := bar_index
        callHit := true
        tp1Done := false
        tp2Done := false
        tp3Done := false
        pend := 0
        if orbCall
            orbUsed := true
        // Sticky card on this bar — stays put as you scroll
        label.new(bar_index, low, f_card('CALL', entryKind, entry, sl, tp1, tp2, tp3), style=label.style_label_up, color=color.new(color.lime, 10), textcolor=color.black, size=size.normal, textalign=text.align_left)
        lnEntry := line.new(bar_index, entry, bar_index + 1, entry, color=color.new(color.white, 20), style=line.style_dashed, width=1)
        lnSl := line.new(bar_index, sl, bar_index + 1, sl, color=color.red, width=2)
        lnTp1 := line.new(bar_index, tp1, bar_index + 1, tp1, color=color.new(#69f0ae, 0), style=line.style_dotted, width=1)
        lnTp2 := line.new(bar_index, tp2, bar_index + 1, tp2, color=color.new(#00e676, 0), style=line.style_dotted, width=1)
        lnTp3 := line.new(bar_index, tp3, bar_index + 1, tp3, color=color.new(#00c853, 0), width=2)

if goPut
    if inPos and side == 'CALL'
        flipHit := true
        inPos := false
    entry := close
    sl := fromOrbPut and not na(orbHi) ? orbHi + atr * atrMultSL * 0.25 : high + atr * atrMultSL
    risk = sl - entry
    if risk > 0
        tp1 := entry - risk
        tp2 := entry - risk * 2
        tp3 := entry - risk * rr
        inPos := true
        side := 'PUT'
        markSide := 'PUT'
        entryKind := fromOrbPut ? 'ORB' : 'EMA'
        entryBar := bar_index
        putHit := true
        tp1Done := false
        tp2Done := false
        tp3Done := false
        pend := 0
        if orbPut
            orbUsed := true
        label.new(bar_index, high, f_card('PUT', entryKind, entry, sl, tp1, tp2, tp3), style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.normal, textalign=text.align_left)
        lnEntry := line.new(bar_index, entry, bar_index + 1, entry, color=color.new(color.white, 20), style=line.style_dashed, width=1)
        lnSl := line.new(bar_index, sl, bar_index + 1, sl, color=color.red, width=2)
        lnTp1 := line.new(bar_index, tp1, bar_index + 1, tp1, color=color.new(#69f0ae, 0), style=line.style_dotted, width=1)
        lnTp2 := line.new(bar_index, tp2, bar_index + 1, tp2, color=color.new(#00e676, 0), style=line.style_dotted, width=1)
        lnTp3 := line.new(bar_index, tp3, bar_index + 1, tp3, color=color.new(#00c853, 0), width=2)

// Stretch level rays with the open trade so they track across bars
if inPos and not na(lnEntry)
    line.set_x2(lnEntry, bar_index)
    line.set_x2(lnSl, bar_index)
    line.set_x2(lnTp1, bar_index)
    line.set_x2(lnTp2, bar_index)
    line.set_x2(lnTp3, bar_index)

// --- Visuals ---
bgcolor(not canEnter ? color.new(color.gray, 93) : na)
plot(emaF, 'EMA 5', color=color.new(color.teal, 0), linewidth=2)
plot(emaS, 'EMA 21', color=color.new(color.orange, 0), linewidth=2)
plot(orbReady and canEnter ? orbHi : na, 'ORB Hi', color=color.new(#00bcd4, 30), style=plot.style_linebr)
plot(orbReady and canEnter ? orbLo : na, 'ORB Lo', color=color.new(#ff7043, 30), style=plot.style_linebr)

// Legend / data-window values follow the bar under your cursor
plot(inPos ? entry : na, 'Entry', color=color.new(color.white, 100), display=display.data_window)
plot(inPos ? sl : na, 'SL', color=color.new(color.red, 100), display=display.data_window)
plot(inPos ? tp1 : na, 'TP1', color=color.new(#69f0ae, 100), display=display.data_window)
plot(inPos ? tp2 : na, 'TP2', color=color.new(#00e676, 100), display=display.data_window)
plot(inPos ? tp3 : na, 'TP3', color=color.new(#00c853, 100), display=display.data_window)
plot(callHit ? 1 : putHit ? -1 : 0, 'Side (+CALL/-PUT)', color=color.new(color.aqua, 100), display=display.data_window)

plotshape(callHit, title='BULL CALL', style=shape.labelup, location=location.belowbar, color=color.lime, text='BULL CALL', textcolor=color.black, size=size.small)
plotshape(putHit, title='BEAR PUT', style=shape.labeldown, location=location.abovebar, color=color.red, text='BEAR PUT', textcolor=color.white, size=size.small)
plotshape(slHit, title='SL', style=shape.xcross, location=location.belowbar, color=color.red, text='SL', textcolor=color.white, size=size.tiny)
plotshape(eodHit, title='EOD', style=shape.xcross, location=location.abovebar, color=color.gray, text='EOD', textcolor=color.white, size=size.tiny)

if tp1Hit
    label.new(bar_index, tp1, 'TP1 ' + str.tostring(tp1, format.mintick), style=markSide == 'PUT' ? label.style_label_up : label.style_label_down, color=#69f0ae, textcolor=color.black, size=size.small)
if tp2Hit
    label.new(bar_index, tp2, 'TP2 ' + str.tostring(tp2, format.mintick), style=markSide == 'PUT' ? label.style_label_up : label.style_label_down, color=#00e676, textcolor=color.black, size=size.small)
if tp3Hit
    label.new(bar_index, tp3, 'TP3 ' + str.tostring(tp3, format.mintick), style=markSide == 'PUT' ? label.style_label_up : label.style_label_down, color=#00c853, textcolor=color.white, size=size.normal)

// --- Alerts ---
alertcondition(callHit, 'ENTRY CALL', 'ENTRY CALL {{ticker}}')
alertcondition(putHit, 'ENTRY PUT', 'ENTRY PUT {{ticker}}')
alertcondition(tp1Hit, 'TP1', 'TP1 {{ticker}}')
alertcondition(tp2Hit, 'TP2', 'TP2 {{ticker}}')
alertcondition(tp3Hit, 'TP3', 'TP3 {{ticker}}')
alertcondition(slHit, 'SL', 'SL {{ticker}}')
alertcondition(eodHit, 'EOD', 'EOD FLAT {{ticker}}')
alertcondition(flipHit, 'FLIP', 'FLIP {{ticker}}')

if callHit
    alert('ENTRY CALL ' + entryKind + ' ' + syminfo.ticker + ' ' + str.tostring(close) + ' sl=' + str.tostring(sl) + ' tp1=' + str.tostring(tp1) + ' tp2=' + str.tostring(tp2) + ' tp3=' + str.tostring(tp3), alert.freq_once_per_bar_close)
if putHit
    alert('ENTRY PUT ' + entryKind + ' ' + syminfo.ticker + ' ' + str.tostring(close) + ' sl=' + str.tostring(sl) + ' tp1=' + str.tostring(tp1) + ' tp2=' + str.tostring(tp2) + ' tp3=' + str.tostring(tp3), alert.freq_once_per_bar_close)
if tp1Hit
    alert('TP1 ' + syminfo.ticker, alert.freq_once_per_bar_close)
if tp2Hit
    alert('TP2 ' + syminfo.ticker, alert.freq_once_per_bar_close)
if tp3Hit
    alert('TP3 ' + syminfo.ticker, alert.freq_once_per_bar_close)
if slHit
    alert('SL ' + syminfo.ticker, alert.freq_once_per_bar_close)
if eodHit
    alert('EOD FLAT ' + syminfo.ticker, alert.freq_once_per_bar_close)
